# DeepSeek V4 Flash through the official DeepSeek API. Only needed for `npm run dev` with a real
# model; every deterministic test and `npm run demo:faults` use a scripted provider and a local fake API.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional: pricing (USD per million tokens) so runs report cost. Left empty, cost is reported as "unavailable".
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

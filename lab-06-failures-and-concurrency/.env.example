# DeepSeek Flash through the official DeepSeek API.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Optional live-experiment knob: artificial delay, in milliseconds, added
# before get_port_status returns. Experiments B and C (steer vs. followUp)
# fall back to 900ms on their own when this is unset. Leave unset for
# experiments A and D, which default to 0.
LAB06_PORT_STATUS_DELAY_MS=

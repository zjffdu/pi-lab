{
  "name": "pi-lab-21-durable-effects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "demo:effects": "node --import tsx scripts/effects-demo.ts",
    "outbox": "node --import tsx scripts/outbox-cli.ts",
    "manifest": "node --import tsx scripts/write-manifest.ts",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.23.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}

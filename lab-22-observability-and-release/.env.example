# DeepSeek V4 Flash through the official DeepSeek API. Only needed for `npm run evaluate:live`
# (the bounded live-evaluation layer). `npm run check`, `npm run run:dev`/`run:held-out`,
# `npm run evaluate`, `npm run calibrate`, and `npm run release-gate` use only the deterministic
# rubric judge and never call a model.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional: pricing (USD per million tokens) so live runs report cost. Left empty, cost is
# reported as "unavailable" rather than silently zero.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

{
  "name": "pi-lab-19-untrusted-context",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --use-env-proxy --import tsx src/index.ts",
    "demo:injection": "node --import tsx scripts/injection-demo.ts",
    "token": "node --import tsx scripts/issue-token.ts",
    "manifest": "node --import tsx scripts/write-manifest.ts",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:trace": "LAB19_TRACE=1 node --use-env-proxy --import tsx src/index.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "dotenv": "17.2.3",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}

# Local PostgreSQL dedicated to this lab. `npm run db:up` starts a container and writes the real
# value into the ignored .env; leave it empty here.
DATABASE_URL=

# DeepSeek V4 Flash through the official DeepSeek API. Only needed for `npm run dev` with a real
# model; every deterministic test and `npm run demo:approval` use a scripted provider.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

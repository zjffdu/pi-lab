{
  "name": "pi-lab-18-human-approval",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --use-env-proxy --import tsx src/index.ts",
    "dev:trace": "LAB18_TRACE=1 node --use-env-proxy --import tsx src/index.ts",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "demo:approval": "node --import tsx scripts/approval-demo.ts",
    "actions": "node --import tsx scripts/actions-cli.ts",
    "token": "node --import tsx scripts/issue-token.ts",
    "manifest": "node --import tsx scripts/write-manifest.ts",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "dotenv": "17.2.3",
    "jose": "6.2.12",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.23.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
